# --- LLM (Groq : console.groq.com > API Keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- LLM OpenRouter : rédaction du CV et de la lettre (openrouter.ai > Keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Secours quand Groq est saturé 
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b
# Lecture des captures d'écran d'offres 
OPENROUTER_VISION_MODELS=["google/gemini-3.1-flash-lite","openai/gpt-6-luna"]

# --- App ---
DATABASE_URL=sqlite:///./matchpilot.db
# En production : postgresql+psycopg://user:password@host:5432/matchpilot
PUBLIC_URL=http://localhost:5173

# --- Sessions ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false

# --- Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth) ---
# URI de redirection autorisée : http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Connexion LinkedIn (linkedin.com/developers > produit "Sign In with LinkedIn using OpenID Connect") ---
# URL de redirection autorisée : http://localhost:5173/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
